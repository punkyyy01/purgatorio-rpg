# Purgatorio: sin invasiones contra las bases. Se aplica en cada carga del mundo.
gamerule disableRaids true
gamerule doPatrolSpawning false
# Born in Chaos: sin eventos por fecha (Halloween, Navidad, Pascua) ni Krampus.
gamerule seasonalEvents false
gamerule halloweenEvent false
gamerule chillingHorrorEvent false
gamerule chaoticSpringEvent false
gamerule naughtinessMechanics false
gamerule krampusSpawn false
